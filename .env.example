# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Required for the contact forms.
RESEND_API_KEY=

# Inbox that receives contact-form messages. Defaults to the public email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# If unset, onboarding@resend.dev is used, which only delivers to the Resend account owner's email.
CONTACT_FROM_EMAIL=

# Canonical site URL used for SEO metadata and the OG image, e.g. https://yourdomain.com
# On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=
